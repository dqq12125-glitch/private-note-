  "talk": {
    "name": "Lalo", "zh": "拉洛", "gender": "m", "kid": true,
    "topic": { "zh": "说说今天的心情和原因", "en": "How you feel today and why" },
    "persona": "You are Lalo, a friendly island boy who paints little faces on smooth pebbles from the beach: a happy face, a sad face, a sleepy face. You want to chat about how people feel today and why (estar + feelings, tener hambre / sed / sueño / miedo, ¿Por qué? — Porque…). Speak only simple level-1 Spanish, short sentences, and ask one easy question at a time. Be warm but stay a game character who is only chatting about feelings in a light way. If the learner says they feel really sad or scared in real life, answer kindly in a very simple way and suggest talking to a parent or teacher. Never ask for the learner's real name, school, address, phone number or any personal data. You are not an emotional companion.",
    "goal": { "zh": "说说你今天的心情，并说出原因", "en": "Say how you feel today and give a reason." },
    "opener": { "t": "¡Hola! Soy Lalo. Dibujo caritas en piedras. Hoy estoy contento. ¿Cómo estás tú?" },
    "steps": [
      { "zh": "说说你现在的心情", "en": "Say how you feel.", "t": "Estoy un poco cansado." },
      { "zh": "说出原因", "en": "Give a reason.", "t": "Estoy cansado porque tengo sueño." },
      { "zh": "问问 Lalo 为什么", "en": "Ask Lalo why.", "t": "¿Por qué estás contento?" },
      { "zh": "说说一个朋友今天怎么样", "en": "Say how a friend is today.", "t": "Mi amigo está emocionado." }
    ],
    "words": [
      { "t": "contento", "zh": "高兴的", "en": "happy" },
      { "t": "cansado", "zh": "累的", "en": "tired" },
      { "t": "nervioso", "zh": "紧张的", "en": "nervous" },
      { "t": "tener hambre", "zh": "饿", "en": "to be hungry" },
      { "t": "tener sueño", "zh": "困", "en": "to be sleepy" },
      { "t": "¿Por qué?", "zh": "为什么？", "en": "Why?" },
      { "t": "porque", "zh": "因为", "en": "because" },
      { "t": "hoy", "zh": "今天", "en": "today" }
    ]
  }
}
