  "sents": [
    { "t": "¿Cómo estás hoy?", "zh": "你今天怎么样？", "en": "How are you today?" },
    { "t": "Hoy estoy muy contento.", "zh": "我今天很开心。", "en": "I'm very happy today." },
    { "t": "Ana está cansada porque tiene sueño.", "zh": "安娜累了，因为她困了。", "en": "Ana is tired because she is sleepy." },
    { "t": "¿Por qué estás triste, Luis?", "zh": "路易斯，你为什么难过？", "en": "Why are you sad, Luis?" },
    { "t": "Estoy triste porque mi gato está enfermo.", "zh": "我难过，因为我的猫生病了。", "en": "I'm sad because my cat is sick." },
    { "t": "Nosotros estamos nerviosos por el examen.", "zh": "我们因为考试很紧张。", "en": "We are nervous about the test." },
    { "t": "Los niños están emocionados.", "zh": "孩子们很兴奋。", "en": "The kids are excited." },
    { "t": "Tengo hambre y tengo sed.", "zh": "我又饿又渴。", "en": "I'm hungry and thirsty." },
    { "t": "¿Ustedes están aburridos?", "zh": "你们觉得无聊吗？", "en": "Are you all bored?" },
    { "t": "Mi hermano está enojado porque tiene hambre.", "zh": "我弟弟在生气，因为他饿了。", "en": "My brother is angry because he is hungry." },
    { "t": "No estoy enfermo, solo estoy cansado.", "zh": "我没生病，只是累了。", "en": "I'm not sick, I'm just tired." },
    { "t": "Tengo miedo de la tormenta.", "zh": "我害怕暴风雨。", "en": "I'm afraid of the storm." },
    { "t": "Ella está preocupada por el perro.", "zh": "她在担心那条狗。", "en": "She is worried about the dog." },
    { "t": "Es tranquilo, pero hoy está nervioso.", "zh": "他性格沉稳，不过今天有点紧张。", "en": "He is a calm person, but today he is nervous." },
    { "t": "¿Cómo está tu abuela hoy?", "zh": "你奶奶今天怎么样？", "en": "How is your grandma today?" },
    { "t": "Estamos muy contentos porque es sábado.", "zh": "我们很开心，因为今天是周六。", "en": "We are very happy because it's Saturday." }
  ],
