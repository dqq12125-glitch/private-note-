  "sents": [
    { "t": "Yo soy Diego y soy muy curioso.", "zh": "我是迭戈，我很好奇。", "en": "I'm Diego and I'm very curious." },
    { "t": "Tú eres muy simpática, Ana.", "zh": "安娜，你人很好。", "en": "You are very friendly, Ana." },
    { "t": "Mi mejor amigo es divertido.", "zh": "我最好的朋友很有趣。", "en": "My best friend is fun." },
    { "t": "Ella es tímida, pero es muy valiente.", "zh": "她很害羞，但是非常勇敢。", "en": "She is shy, but she is very brave." },
    { "t": "Nosotros somos amigos desde pequeños.", "zh": "我们从小就是朋友。", "en": "We have been friends since we were little." },
    { "t": "Mi amiga Sofía es rubia y tiene el pelo largo.", "zh": "我的朋友索菲娅是金发，头发很长。", "en": "My friend Sofía is blond and has long hair." },
    { "t": "Los ojos de Luis son castaños.", "zh": "路易斯的眼睛是棕色的。", "en": "Luis's eyes are brown." },
    { "t": "No soy tímido, soy tranquilo.", "zh": "我不是害羞，我是比较安静。", "en": "I'm not shy, I'm calm." },
    { "t": "Ustedes son muy amables.", "zh": "你们人真好。", "en": "You are all very kind." },
    { "t": "Mi hermana tiene el pelo corto y rizado.", "zh": "我姐姐的头发又短又卷。", "en": "My sister has short, curly hair." },
    { "t": "¿Cómo es tu mejor amiga?", "zh": "你最好的朋友是什么样的人？", "en": "What is your best friend like?" },
    { "t": "Es inteligente y muy simpática.", "zh": "她很聪明，人也很好。", "en": "She is smart and very friendly." },
    { "t": "Mis amigos son divertidos y curiosos.", "zh": "我的朋友们既有趣又好奇。", "en": "My friends are fun and curious." },
    { "t": "Ellos no son tímidos.", "zh": "他们不害羞。", "en": "They are not shy." },
    { "t": "Soy nuevo en la isla, pero ya tengo amigos.", "zh": "我刚来岛上，但已经有朋友了。", "en": "I'm new on the island, but I already have friends." },
    { "t": "¿Eres tranquilo o divertido?", "zh": "你是比较安静还是比较有趣？", "en": "Are you calm or fun?" }
  ],
