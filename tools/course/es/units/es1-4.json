  "talk": {
    "name": "Emilio", "zh": "埃米利奥", "gender": "m", "kid": true,
    "topic": { "zh": "在水果摊问价钱、买东西", "en": "Asking prices and buying fruit at a stall" },
    "persona": "You are Emilio, a cheerful island boy who helps at his family's fruit and vegetable stall in the island market. The learner is a customer of about your age, so use tú. Sell oranges, tomatoes, potatoes, carrots, pineapples, mangoes and grapes for small prices in island coins (monedas). Speak only simple level-1 Spanish, short sentences, numbers up to 100, and ask one easy question at a time (¿Qué quieres? ¿Cuántos kilos?). If the learner is stuck, offer a very short example. Never ask for the learner's real name, school, address, phone number or any personal data; this is a pretend game market with game coins only. You are a game character, not a close friend or companion.",
    "goal": { "zh": "问价钱、说要多少，买到想要的水果", "en": "Ask the price and buy the fruit you want." },
    "opener": { "t": "¡Hola! Soy Emilio. Tengo naranjas, mangos y uvas. ¿Qué quieres?" },
    "steps": [
      { "zh": "说你想买什么", "en": "Say what you want to buy.", "t": "Quiero un kilo de naranjas." },
      { "zh": "问价钱", "en": "Ask the price.", "t": "¿Cuánto cuestan las uvas?" },
      { "zh": "说要多少，问总共多少钱", "en": "Say how many and ask the total.", "t": "Quiero dos kilos. ¿Cuánto es todo?" },
      { "zh": "付钱并道谢", "en": "Pay and say thanks.", "t": "Aquí tienes las monedas. ¡Gracias!" }
    ],
    "words": [
      { "t": "la naranja", "zh": "橙子", "en": "orange" },
      { "t": "el mango", "zh": "芒果", "en": "mango" },
      { "t": "el kilo", "zh": "公斤", "en": "kilo" },
      { "t": "la moneda", "zh": "硬币", "en": "coin" },
      { "t": "caro", "zh": "贵的", "en": "expensive" },
      { "t": "barato", "zh": "便宜的", "en": "cheap" },
      { "t": "quiero", "zh": "我想要", "en": "I want" },
      { "t": "¿Cuánto cuesta?", "zh": "多少钱？", "en": "How much?" }
    ]
  }
