  "sents": [
    { "t": "¿Cuánto cuesta un kilo de tomates?", "zh": "一公斤西红柿多少钱？", "en": "How much is a kilo of tomatoes?" },
    { "t": "Cuesta cinco monedas.", "zh": "五个硬币。", "en": "It costs five coins." },
    { "t": "Quiero dos kilos de naranjas, por favor.", "zh": "请给我两公斤橙子。", "en": "I want two kilos of oranges, please." },
    { "t": "¿Cuánto cuestan estas uvas?", "zh": "这些葡萄多少钱？", "en": "How much are these grapes?" },
    { "t": "Estas uvas cuestan veinte monedas.", "zh": "这些葡萄二十个硬币。", "en": "These grapes cost twenty coins." },
    { "t": "Este mango es muy caro.", "zh": "这个芒果很贵。", "en": "This mango is very expensive." },
    { "t": "Las papas están baratas hoy.", "zh": "今天土豆很便宜。", "en": "The potatoes are cheap today." },
    { "t": "Quiero una bolsa de limones.", "zh": "我想要一袋柠檬。", "en": "I want a bag of lemons." },
    { "t": "¿Quieres esta piña o la sandía?", "zh": "你要这个菠萝还是西瓜？", "en": "Do you want this pineapple or the watermelon?" },
    { "t": "Tengo cincuenta monedas.", "zh": "我有五十个硬币。", "en": "I have fifty coins." },
    { "t": "¿Cuántas monedas tienes?", "zh": "你有多少个硬币？", "en": "How many coins do you have?" },
    { "t": "La sandía cuesta treinta monedas.", "zh": "西瓜三十个硬币。", "en": "The watermelon costs thirty coins." },
    { "t": "Quiero tres papas y cuatro cebollas.", "zh": "我想要三个土豆和四个洋葱。", "en": "I want three potatoes and four onions." },
    { "t": "Estos tomates son rojos y muy ricos.", "zh": "这些西红柿红红的，很好吃。", "en": "These tomatoes are red and very tasty." },
    { "t": "Son cien monedas en total.", "zh": "一共一百个硬币。", "en": "It's one hundred coins in total." },
    { "t": "Aquí tienes las monedas.", "zh": "硬币给你。", "en": "Here are the coins." }
  ],
