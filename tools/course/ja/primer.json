        null,
        { "t": "よ", "sub": "ヨ", "rom": "yo", "say": "よ" },

        { "t": "ら", "sub": "ラ", "rom": "ra", "say": "ら",
          "zh": "ら 行：舌尖在上牙后面轻轻弹一下，不是英语的 r，也不是 l。", "en": "The ら row: tap the tip of your tongue once behind your top teeth. It is not quite an English r or l.",
          "ex": [ { "t": "からい", "r": "からい", "zh": "辣", "en": "spicy", "pic": "🌶️" } ] },
        { "t": "り", "sub": "リ", "rom": "ri", "say": "り" },
        { "t": "る", "sub": "ル", "rom": "ru", "say": "る" },
        { "t": "れ", "sub": "レ", "rom": "re", "say": "れ" },
        { "t": "ろ", "sub": "ロ", "rom": "ro", "say": "ろ" },

        { "t": "わ", "sub": "ワ", "rom": "wa", "say": "わ",
          "ex": [ { "t": "わたし", "r": "わたし", "zh": "我", "en": "I; me", "pic": "🙋" } ] },
        null,
        null,
        null,
        { "t": "を", "sub": "ヲ", "rom": "o", "say": "を",
          "zh": "只当助词用，念 o，和 お 一样。", "en": "Only used as a grammar word. It sounds the same as お (o)." },

        { "t": "ん", "sub": "ン", "rom": "n", "say": "ん",
          "zh": "用鼻子出声，自己占一拍，比如 ほん（ho-n）。", "en": "A sound through the nose that takes a whole beat, as in ほん (ho-n)." },
        null,
        null,
        null,
        null
      ]
