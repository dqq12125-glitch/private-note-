        { "t": "な", "sub": "ナ", "rom": "na", "say": "な",
          "ex": [ { "t": "夏", "r": "なつ", "zh": "夏天", "en": "summer", "pic": "🌻" } ] },
        { "t": "に", "sub": "ニ", "rom": "ni", "say": "に" },
        { "t": "ぬ", "sub": "ヌ", "rom": "nu", "say": "ぬ" },
        { "t": "ね", "sub": "ネ", "rom": "ne", "say": "ね" },
        { "t": "の", "sub": "ノ", "rom": "no", "say": "の" },

        { "t": "は", "sub": "ハ", "rom": "ha", "say": "は",
          "zh": "当助词用时念 wa，比如 わたしは（watashi wa）。", "en": "As a grammar word it is read wa, as in わたしは (watashi wa).",
          "ex": [ { "t": "はさみ", "r": "はさみ", "zh": "剪刀", "en": "scissors", "pic": "✂️" } ] },
