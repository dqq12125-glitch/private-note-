    {
      "id": "daku",
      "title": { "zh": "浊音和半浊音：が、ぱ", "en": "Dots and circles: が, ぱ" },
      "intro": {
        "zh": "假名右上角加两点「゛」，音变浊（念的时候喉咙会振动）：か ka → が ga，さ sa → ざ za，た ta → だ da，は ha → ば ba。は 行加一个小圈「゜」，就变成 p：ぱ pa。",
        "en": "Two dots 「゛」 at the top right make a voiced sound (your throat buzzes): か ka → が ga, さ sa → ざ za, た ta → だ da, は ha → ば ba. A small circle 「゜」 on the は row turns it into p: ぱ pa."
      },
      "layout": "grid",
      "cols": 5,
      "items": [
        { "t": "が", "sub": "ガ", "rom": "ga", "say": "が" },
        { "t": "ぎ", "sub": "ギ", "rom": "gi", "say": "ぎ" },
        { "t": "ぐ", "sub": "グ", "rom": "gu", "say": "ぐ" },
        { "t": "げ", "sub": "ゲ", "rom": "ge", "say": "げ" },
        { "t": "ご", "sub": "ゴ", "rom": "go", "say": "ご",
          "ex": [ { "t": "ごはん", "r": "ごはん", "zh": "米饭", "en": "cooked rice", "pic": "🍚" } ] },

        { "t": "ざ", "sub": "ザ", "rom": "za", "say": "ざ" },
        { "t": "じ", "sub": "ジ", "rom": "ji", "say": "じ" },
        { "t": "ず", "sub": "ズ", "rom": "zu", "say": "ず" },
        { "t": "ぜ", "sub": "ゼ", "rom": "ze", "say": "ぜ" },
        { "t": "ぞ", "sub": "ゾ", "rom": "zo", "say": "ぞ",
          "ex": [ { "t": "ぞう", "r": "ぞう", "zh": "大象", "en": "elephant", "pic": "🐘" } ] },

        { "t": "だ", "sub": "ダ", "rom": "da", "say": "だ" },
        { "t": "ぢ", "sub": "ヂ", "rom": "ji", "say": "ぢ",
          "zh": "念法和 じ 一样，很少用。", "en": "Sounds the same as じ. Rarely used." },
        { "t": "づ", "sub": "ヅ", "rom": "zu", "say": "づ",
