        { "t": "ど", "sub": "ド", "rom": "do", "say": "ど" },

        { "t": "ば", "sub": "バ", "rom": "ba", "say": "ば",
          "ex": [ { "t": "かばん", "r": "かばん", "zh": "书包", "en": "bag", "pic": "🎒" } ] },
        { "t": "び", "sub": "ビ", "rom": "bi", "say": "び" },
        { "t": "ぶ", "sub": "ブ", "rom": "bu", "say": "ぶ" },
        { "t": "べ", "sub": "ベ", "rom": "be", "say": "べ" },
        { "t": "ぼ", "sub": "ボ", "rom": "bo", "say": "ぼ" },

        { "t": "ぱ", "sub": "パ", "rom": "pa", "say": "ぱ" },
        { "t": "ぴ", "sub": "ピ", "rom": "pi", "say": "ぴ",
          "ex": [ { "t": "えんぴつ", "r": "えんぴつ", "zh": "铅笔", "en": "pencil", "pic": "✏️" } ] },
        { "t": "ぷ", "sub": "プ", "rom": "pu", "say": "ぷ" },
        { "t": "ぺ", "sub": "ペ", "rom": "pe", "say": "ぺ" },
