{
  "lang": "ja",
  "sections": [
    {
      "id": "hira",
      "title": { "zh": "平假名", "en": "Hiragana" },
      "intro": {
        "zh": "日语有平假名、片假名两套字，读音一样：あ 和 ア 都念 a。先认平假名（每格的大字），片假名是小字；点一格就能听。例词里的汉字都标着假名读音。",
        "en": "Japanese has two sets of letters, hiragana and katakana, and they sound the same: あ and ア are both \"a\". Learn hiragana first (the big letter in each box); the small one is katakana. Tap a box to hear it. Kanji in the example words always come with a kana reading."
      },
      "layout": "grid",
      "cols": 5,
      "items": [
        { "t": "あ", "sub": "ア", "rom": "a", "say": "あ",
          "ex": [ { "t": "雨", "r": "あめ", "zh": "雨", "en": "rain", "pic": "🌧️" } ] },
        { "t": "い", "sub": "イ", "rom": "i", "say": "い" },
        { "t": "う", "sub": "ウ", "rom": "u", "say": "う" },
        { "t": "え", "sub": "エ", "rom": "e", "say": "え" },
        { "t": "お", "sub": "オ", "rom": "o", "say": "お" },

        { "t": "か", "sub": "カ", "rom": "ka", "say": "か",
          "ex": [ { "t": "かさ", "r": "かさ", "zh": "伞", "en": "umbrella", "pic": "☂️" } ] },
        { "t": "き", "sub": "キ", "rom": "ki", "say": "き" },
        { "t": "く", "sub": "ク", "rom": "ku", "say": "く" },
        { "t": "け", "sub": "ケ", "rom": "ke", "say": "け" },
        { "t": "こ", "sub": "コ", "rom": "ko", "say": "こ" },

        { "t": "さ", "sub": "サ", "rom": "sa", "say": "さ",
          "ex": [ { "t": "さる", "r": "さる", "zh": "猴子", "en": "monkey", "pic": "🐒" } ] },
        { "t": "し", "sub": "シ", "rom": "shi", "say": "し" },
        { "t": "す", "sub": "ス", "rom": "su", "say": "す" },
