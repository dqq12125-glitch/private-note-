 "key": {
  "t": "你想买什么颜色的衣服？",
  "r": "nǐ xiǎng mǎi shén me yán sè de yī fu?",
  "zh": "",
  "en": "What colour of clothes do you want to buy?"
 },
 "grammar": {
  "title": {
   "zh": "有点 和 一点，试一下",
   "en": "A bit too… vs. a bit more…, and trying"
  },
  "tip": {
   "zh": "「有点 + 形容词」放在形容词前面，说的是不太满意：这件外套有点大。「形容词 + 一点」放在后面，是想要比较一下、换一个：有小一点的吗？想试一试，可以说「试一下」或者「试试」：我可以试一下吗？",
   "en": "有点 goes before an adjective and means \"a bit too…\", a mild complaint: 这件外套有点大 (zhè jiàn wài tào yǒu diǎn dà). 一点 goes after the adjective and asks for a little more or less: 有小一点的吗？ (yǒu xiǎo yì diǎn de ma?). To try something, say 试一下 or 试试: 我可以试一下吗？ (wǒ kě yǐ shì yí xià ma?)."
  }
 },
