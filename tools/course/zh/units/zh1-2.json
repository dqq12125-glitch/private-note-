{
 "book": "zh1",
 "n": 2,
 "t": "多少钱？",
 "zh": "",
 "en": "How Much Is It?",
 "icon": "🍎",
 "color": "#E8A317",
 "key": {
  "t": "你想买什么？一共多少钱？",
  "r": "nǐ xiǎng mǎi shén me? yí gòng duō shao qián?",
  "zh": "",
  "en": "What do you want to buy? How much is it altogether?"
 },
 "grammar": {
  "title": {
   "zh": "几 和 多少；块；两 和 二",
   "en": "几 vs 多少; 块; 两 vs 二"
  },
  "tip": {
   "zh": "问十以内的数量用「几」：你买几个？问价钱用「多少」：一共多少钱？量词前面说「两」，数数和号码里说「二」：两个苹果，二十块。口语里钱说「块」：一块五，十二块。",
   "en": "Use 几 (jǐ) for small numbers (under ten): 你买几个？ (nǐ mǎi jǐ gè?). Use 多少 (duō shao) for prices and big numbers: 一共多少钱？ (yí gòng duō shao qián?). Before a measure word say 两 (liǎng), but in counting and numbers say 二 (èr): 两个苹果 (liǎng gè píng guǒ), 二十块 (èr shí kuài). In speech, money is 块 (kuài): 一块五 (yí kuài wǔ)."
  }
 },
