 "key": {
  "t": "你想吃什么？你想喝什么？",
  "r": "nǐ xiǎng chī shén me? nǐ xiǎng hē shén me?",
  "zh": "",
  "en": "What would you like to eat? What would you like to drink?"
 },
 "grammar": {
  "title": {
   "zh": "想 和 要；还是；太…了",
   "en": "想 vs 要; 还是; 太…了"
  },
  "tip": {
   "zh": "说想吃什么用「想」：我想吃饺子；点菜时更直接，常说「我要…」或者「请给我…」：请给我一杯水。问二选一用「还是」：你喝茶还是果汁？说「都可以」的句子里用「或者」：我吃饺子或者面条都可以。「太…了」表示过头了：这个汤太咸了。",
   "en": "Use 想 (xiǎng) for what you feel like eating: 我想吃饺子 (wǒ xiǎng chī jiǎo zi). When ordering, 要 (yào) and 请给我… (qǐng gěi wǒ…, please give me…) are more direct: 请给我一杯水 (qǐng gěi wǒ yì bēi shuǐ). Ask \"A or B?\" with 还是 (hái shi): 你喝茶还是果汁？ (nǐ hē chá hái shi guǒ zhī?); in statements use 或者 (huò zhě). 太…了 (tài … le) means \"too …\": 这个汤太咸了 (zhè ge tāng tài xián le)."
  }
 },
 "boss": {
  "emoji": "🐧",
  "name": {
   "zh": "厨师企鹅",
   "en": "Chef Pip the Penguin"
